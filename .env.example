# Groq API key — create at https://console.groq.com (free tier, no card required)
GROQ_API_KEY=

# GitHub Personal Access Token — raises unauthenticated API rate limit (60/hr -> 5,000/hr)
# Generate with: gh auth login  (then: gh auth token)
GITHUB_TOKEN=

# Local Postgres (pgvector) — matches infra/docker-compose.yml defaults
DATABASE_URL=postgresql+psycopg://repochat:repochat@localhost:5432/repochat

# Model selection (Groq) — llama-3.3-70b-versatile / llama-3.1-8b-instant were
# deprecated for free/developer tier on 2026-08-16; using Groq's migration targets.
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_SCOPE_CLASSIFIER_MODEL=openai/gpt-oss-20b

# Local embedding model (sentence-transformers, runs on CPU, no API call)
# jinaai/jina-embeddings-v2-base-code was the doc's first choice, but its
# custom remote-code model class calls a transformers.pytorch_utils function
# that was removed in the transformers v5 line -- incompatible as of now.
# Using the doc's own documented fallback instead.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

