# Groq API key — create at https://console.groq.com (free tier, no card required)
GROQ_API_KEY=

# GitHub Personal Access Token — raises unauthenticated API rate limit (60/hr -> 5,000/hr)
# Generate with: gh auth login  (then: gh auth token)
GITHUB_TOKEN=

# Local Postgres (pgvector) — matches infra/docker-compose.yml defaults
DATABASE_URL=postgresql+psycopg://repochat:repochat@localhost:5432/repochat

# Model selection (Groq) — llama-3.3-70b-versatile / llama-3.1-8b-instant were
# deprecated for free/developer tier on 2026-08-16; using Groq's migration targets.
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_SCOPE_CLASSIFIER_MODEL=openai/gpt-oss-20b

# Local embedding model (sentence-transformers; GPU if torch is CUDA-enabled
# and one is available, otherwise CPU -- picked up automatically, no config
# needed here. See pyproject.toml for how to install a CUDA-enabled torch.)
# jinaai/jina-embeddings-v2-base-code was the doc's first choice, but its
# custom remote-code model class needs transformers<4.40.0, which directly
# conflicts with sentence-transformers' own requirement of transformers>=5.0
# -- not a version to pin around, the two constraints don't overlap at all.
# jina-embeddings-v3 (newer) hit a different unresolved error, same class of
# custom-remote-code fragility. gte-modernbert-base is ModernBERT, built
# natively into transformers itself (no trust_remote_code, ever) and
# verified to rank code identifiers better than all-MiniLM-L6-v2 in practice.
EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base

# Reranker (Phase 5) -- the doc's primary pick (hq-bench/coreb-code-reranker)
# is a 4B-param model, ~8GB download, impractical for CPU-only inference on
# this machine. Using its own documented ablation-baseline model as primary
# instead, same reasoning as the embedding-model swap above.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

